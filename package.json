{
  "name": "begoma-game",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "vitest run --coverage",
    "test:watch": "vitest",
    "lint": "eslint src tests",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.{ts,js,json,html}\"",
    "format:check": "prettier --check \"src/**/*.{ts,css}\" \"tests/**/*.ts\" \"*.{ts,js,json,html}\""
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "~0.14.0",
    "three": "~0.169.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.0.0",
    "@types/three": "~0.169.0",
    "@vitest/coverage-v8": "^3.0.0",
    "eslint": "^9.0.0",
    "prettier": "^3.3.0",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.8.0",
    "vite": "^6.0.0",
    "vitest": "^3.0.0"
  }
}
